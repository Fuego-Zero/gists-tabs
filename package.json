{
  "name": "gists-tabs",
  "version": "1.0.7",
  "description": "芸笺 · Gists Tabs：Chrome 新标签页个人工作台（多页画布小组件；本机存储，可选 Gist 同步）",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fuego-Zero/gist-tabs.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "tsc --noEmit && wxt build",
    "build:firefox": "tsc --noEmit && wxt build -b firefox",
    "lint": "tsc --noEmit && eslint .",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types --test src/storage/snapshotCache.test.ts src/storage/initialCanvas.test.ts src/storage/retryDelay.test.ts src/storage/syncRules.test.ts src/storage/widgetPositions.test.ts src/pages/Newtab/components/ContentArea/components/clock/formatClock.test.ts",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,yml}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@webext-core/messaging": "^2.3.0",
    "antd": "^6.6.6",
    "axios": "1.7.8",
    "classnames": "2.5.1",
    "dayjs": "1.11.13",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fuego0/configs": "1.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/i18n": "^0.1.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^10.4.0",
    "prettier": "^3.6.0",
    "sass": "^1.80.6",
    "tailwindcss": "^4.1.0",
    "typescript": "5.7.3",
    "wxt": "^0.20.0"
  }
}
