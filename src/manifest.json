{
  "manifest_version": 3,
  "name": "芸笺",
  "description": "个人新标签页工作台：多页画布上挂书签、时钟等小组件；数据默认本机存储，可选同步到 GitHub Gist。",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon-128.png",
        "icon-34.png"
      ],
      "matches": []
    }
  ],
  "short_name": "芸笺"
}
